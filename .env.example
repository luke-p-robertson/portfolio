# Luke Robertson Studio — environment
#
# NOTE: You do NOT need an `.env.local` to run the site. The Sanity project id and
# dataset are public, non-secret identifiers baked into `sanity/lib/projectId.ts`
# (injected via `next.config.ts`). A fresh clone runs with no env setup.
#
# Copy this file to `.env.local` only to OVERRIDE a default below, to set the
# server-only secret.

# --- Optional overrides (defaults live in sanity/lib/projectId.ts) ---
# NEXT_PUBLIC_SANITY_PROJECT_ID=x47vlamh
# NEXT_PUBLIC_SANITY_DATASET=production

# Optional: override site origin for preview/staging deploys.
# Default is set in lib/siteUrl.ts (https://lukerobertson.studio).
# NEXT_PUBLIC_SITE_URL=https://preview.example.com

# --- Server-only secret (NOT public; set per-environment, never commit a real value) ---
# Secret for Sanity webhook → POST https://lukerobertson.studio/api/revalidate?secret=...
SANITY_REVALIDATE_SECRET=

# Embedded Studio at /cms requires your app origin in Sanity CORS (with credentials).
# After `npx sanity login`:
#   npx sanity cors add http://localhost:3000 --credentials   # local dev
#   npx sanity cors add https://lukerobertson.studio --credentials   # production
